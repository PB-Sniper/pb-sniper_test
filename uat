javascript:(function(){
    if(document.getElementById('pbs-main-panel')) return;

    var serverOffset = 0;
    var lastPlannedFireTime = null;
    var countdownTimer = null;
    var suspendedRetryEnabled = true;
    var autoCheckoutEnabled = false; // 新增：是否啟動自動結帳跳轉

    // --- 1. LOG 面板 ---
    var logPanel = document.createElement('div');
    logPanel.id = 'pbs-log-panel';
    logPanel.style.cssText = 'position:fixed;bottom:20px;left:20px;width:400px;height:280px;overflow-y:auto;background:rgba(0,0,0,0.9);color:#fff;font-family:Consolas,monospace;font-size:12px;padding:10px;border:1px solid #555;border-radius:6px;z-index:999999;white-space:pre-wrap;box-shadow:0 4px 10px rgba(0,0,0,0.5);display:none;';
    document.body.appendChild(logPanel);

    function log(type, msg) {
        logPanel.style.display = 'block';
        var line = document.createElement('div');
        var color = '#fff';
        if(type === 'SUCCESS') color = '#00ff88';
        if(type === 'INFO')    color = '#00d0ff';
        if(type === 'WARNING') color = '#ffcc00';
        if(type === 'ERROR')   color = '#ff4444';
        if(type === 'GUARD')   color = '#00bfff';

        var nowForLog = new Date(Date.now() + serverOffset);
        var time = nowForLog.toLocaleTimeString('en-GB') + '.' + String(nowForLog.getMilliseconds()).padStart(3,'0');
        line.style.color = color;
        line.style.borderBottom = '1px solid #333';
        line.style.padding = '2px 0';
        line.innerText = '[' + time + '] [' + type + '] ' + msg;
        logPanel.appendChild(line);
        logPanel.scrollTop = logPanel.scrollHeight;
    }

    // --- 2. Guardian ---
    log('GUARD', 'Session Guardian V3.0 已啟動，每 4 分鐘靜默保活');
    var guardTimer = setInterval(function() {
        fetch(window.location.href, { method: 'HEAD' }).catch(()=>{});
    }, 240000);

    // --- 3. 控制面板 ---
    var panel = document.createElement('div');
    panel.id = 'pbs-main-panel';
    panel.style.cssText = 'position:fixed;bottom:20px;right:20px;width:320px;background:rgba(20,20,20,0.95);color:#fff;z-index:999999;padding:15px;border-radius:8px;font-size:13px;border:1px solid #444;box-shadow:0 4px 15px rgba(0,0,0,0.5);font-family:sans-serif;';
    panel.innerHTML = '\
        <h3 style="color:#fc0;margin:0 0 10px;border-bottom:1px solid #555;padding-bottom:5px;font-size:16px;font-weight:bold;display:flex;justify-content:space-between;">\
            <span>P-Bandai Sniper V7.5</span>\
            <span id="pbs-close-btn" style="cursor:pointer;color:#999;padding:0 5px;">✕</span>\
        </h3>\
        <div style="margin-bottom:8px">\
            <label style="display:block;color:#ccc;font-size:11px">⏰ Time (HH:MM:SS)</label>\
            <input id="pbs-time" value="15:00:00" style="width:100%;padding:5px;background:#333;color:#fff;border:1px solid #555;border-radius:4px;box-sizing:border-box;">\
            <button id="pbs-sync" style="margin-top:4px;padding:4px 6px;font-size:11px;background:#007bff;color:#fff;border:none;border-radius:4px;cursor:pointer;">Sync Time</button>\
        </div>\
        <div id="pbs-countdown" style="margin-bottom:4px;text-align:center;font-size:16px;color:#0fd;">--.-- s</div>\
        <div style="display:flex;gap:10px;margin-bottom:8px">\
            <div style="flex:1"><label style="display:block;color:#ccc;font-size:11px">🔢 Qty</label><input id="pbs-qty" type="number" value="1" style="width:100%;padding:5px;background:#333;color:#fff;border:1px solid #555;border-radius:4px;box-sizing:border-box;"></div>\
            <div style="flex:1"><label style="display:block;color:#ccc;font-size:11px">🕰️ Offset (ms)</label><input id="pbs-offset" type="number" value="0" style="width:100%;padding:5px;background:#333;color:#fff;border:1px solid #555;border-radius:4px;box-sizing:border-box;"></div>\
        </div>\
        <div style="margin-bottom:6px;display:flex;justify-content:space-between;font-size:11px;">\
            <label><input id="pbs-sus-toggle" type="checkbox" checked> 400 Retry</label>\
            <label style="color:#0f0;font-weight:bold;"><input id="pbs-checkout-toggle" type="checkbox" checked> ⚡ 自動跳轉結帳</label>\
        </div>\
        <div style="margin-bottom:10px">\
            <label style="display:block;color:#ccc;font-size:11px">📋 Paste Fetch (addToCart)</label>\
            <textarea id="pbs-fetch" rows="3" style="width:100%;padding:5px;background:#333;color:#aaa;border:1px solid #555;border-radius:4px;font-size:11px;resize:vertical;box-sizing:border-box;"></textarea>\
        </div>\
        <button id="pbs-btn" style="width:100%;padding:10px;background:#28a745;color:#fff;border:none;border-radius:4px;cursor:pointer;font-weight:bold;">🚀 Start Sniper</button>\
        <div id="pbs-status" style="margin-top:5px;text-align:center;color:#aaa;font-size:11px">Ready.</div>\
    ';
    document.body.appendChild(panel);

    document.getElementById('pbs-close-btn').onclick = function() {
        panel.remove(); logPanel.style.display = 'none';
        clearInterval(guardTimer); if(countdownTimer) clearInterval(countdownTimer);
    };

    var timeInput = document.getElementById('pbs-time'), qtyInput = document.getElementById('pbs-qty'), offsetInput = document.getElementById('pbs-offset'), fetchInput = document.getElementById('pbs-fetch'), btn = document.getElementById('pbs-btn'), status = document.getElementById('pbs-status'), cdLabel = document.getElementById('pbs-countdown');
    document.getElementById('pbs-sus-toggle').onchange = function() { suspendedRetryEnabled = this.checked; };
    document.getElementById('pbs-checkout-toggle').onchange = function() { autoCheckoutEnabled = this.checked; };
    
    // 預設開啟自動跳轉
    autoCheckoutEnabled = document.getElementById('pbs-checkout-toggle').checked;

    document.getElementById('pbs-sync').onclick = function() {
        var t0 = Date.now();
        fetch(window.location.href, { method: 'HEAD', cache: 'no-store' }).then(r => {
            var d = r.headers.get('date');
            if(d) {
                var t1 = Date.now();
                serverOffset = (new Date(d).getTime() + ((t1 - t0) / 2)) - t1;
                log('SUCCESS', '對錶完成，與伺服器時差: ' + serverOffset + 'ms');
            }
        });
    };

    // 自動讀取 areaItemNo
    var pid = null;
    try {
        var scripts = [].slice.call(document.querySelectorAll('script'));
        for (var i = 0; i < scripts.length; i++) {
            if (scripts[i].textContent.includes('PRELOAD_DATA =')) {
                var m = scripts[i].textContent.match(/PRELOAD_DATA\s*=\s*({.*?})\s*$/m);
                if (m) {
                    var d = JSON.parse(m[1]);
                    if(d.product && d.product.areaItemNos) { pid = d.product.areaItemNos[0]; status.innerHTML = 'Locked: ' + pid; status.style.color = '#0f0'; }
                }
                break;
            }
        }
    } catch(e) {}

    btn.onclick = function() {
        var timeStr = timeInput.value, qty = parseInt(qtyInput.value)||1, offset = parseInt(offsetInput.value)||0, fetchCode = fetchInput.value;
        if (!pid) { log('ERROR', '無法在當前頁面找到商品 ID，請確認這是一頁商品頁'); return; }
        if (!fetchCode) { log('ERROR', '請貼上 Copy as Fetch 內容'); return; }

        var match = fetchCode.match(/fetch\((["'])(.*?)\1,\s*({[\s\S]*})\)/);
        if(!match){
             try {
                let sUrl = fetchCode.indexOf('fetch('), q = "'";
                if(fetchCode.indexOf('"', sUrl) !== -1 && (fetchCode.indexOf("'", sUrl) === -1 || fetchCode.indexOf('"', sUrl) < fetchCode.indexOf("'", sUrl))) q = '"';
                let sUrlC = fetchCode.indexOf(q, sUrl) + 1, eUrlC = fetchCode.indexOf(q, sUrlC), u = fetchCode.substring(sUrlC, eUrlC);
                let sObj = fetchCode.indexOf('{', eUrlC), eObj = fetchCode.lastIndexOf('}'), cStr = fetchCode.substring(sObj, eObj + 1);
                match = [null, q, u, cStr];
            } catch(e) { log('ERROR', 'Fetch 格式解析失敗，請重新 Copy'); return; }
        }

        var url = match[2], configStr = match[3], config;
        try { config = new Function('return ' + configStr)(); } catch(e) { log('ERROR', 'Fetch Config 解析失敗'); return; }
        config.body = JSON.stringify([{ areaItemNo: pid, qty: qty }]);
        config.credentials = 'include';

        var target = new Date(Date.now() + serverOffset), t = timeStr.split(':');
        target.setHours(t[0], t[1], t[2], 0);
        var delay = target.getTime() - (Date.now() + serverOffset) + offset;
        lastPlannedFireTime = target.getTime() + offset;

        btn.disabled = true; btn.style.opacity = '0.5'; btn.innerText = '⏳ 倒數中...';
        log('INFO', '目標鎖定: ' + target.toLocaleTimeString('en-GB') + ' (Offset: ' + offset + 'ms)');

        if(countdownTimer) clearInterval(countdownTimer);
        countdownTimer = setInterval(function(){
            var diff = lastPlannedFireTime - (Date.now() + serverOffset);
            if(diff <= 0){ cdLabel.textContent = '0.00 s'; clearInterval(countdownTimer); return; }
            cdLabel.textContent = (diff/1000).toFixed(2) + ' s';
        }, 100);

        setTimeout(function() {
            var attempt = function(retries, susRetries){
                fetch(url, config).then(r => r.text().then(txt => {
                    var p = null; try{ p = JSON.parse(txt); }catch(_){}
                    
                    if(r.status >= 500 && retries > 0) {
                        log('WARNING', r.status + ' 網絡繁忙，' + retries + ' 次重試機會...');
                        setTimeout(()=>attempt(retries-1, susRetries), 300);
                        return;
                    }
                    if(suspendedRetryEnabled && r.status === 400 && p && p.error && p.error.includes('CouldNotAddToCartBySuspendedItem') && susRetries > 0){
                        log('WARNING', '偵測到 Suspended，提早咗少少，進行 400 突圍重試...');
                        setTimeout(()=>attempt(retries, susRetries-1), 350);
                        return;
                    }

                    if(p && p.totalCartCount){
                        log('SUCCESS', '🎉 加入購物車成功！');
                        
                        // ⚡ V7.5 重點：暗號跳轉
                        if(autoCheckoutEnabled) {
                            log('INFO', '⚡ 準備極速轉區結帳...');
                            setTimeout(function(){ 
                                // 加上 ?auto_checkout=true 暗號，通知 Tampermonkey 做野
                                window.location.href = 'https://p-bandai.com/hk/cart?target=' + pid + '&auto_checkout=true';
                            }, 400); // 留 400ms 俾 PB Server 喘息寫入資料
                        } else {
                            btn.disabled = false; btn.style.opacity = '1'; btn.innerText = '🚀 Start Sniper';
                        }
                    } else {
                        log('ERROR', '回應異常: ' + (txt.length > 50 ? txt.slice(0,50)+'...' : txt));
                        btn.disabled = false; btn.style.opacity = '1'; btn.innerText = '🚀 Start Sniper';
                    }
                })).catch(e => { 
                    log('ERROR', '網絡發送失敗: '+e); 
                    btn.disabled = false; btn.style.opacity = '1'; btn.innerText = '🚀 Start Sniper'; 
                });
            };
            attempt(4, 3);
        }, delay < 0 ? 0 : delay);
    };
})();
